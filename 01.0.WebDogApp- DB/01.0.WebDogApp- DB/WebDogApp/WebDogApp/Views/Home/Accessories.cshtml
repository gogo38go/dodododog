@{
    ViewData["Title"] = "Accessories";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="display-6 fw-bold">Аксесоари за кучета</h1>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-3">

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://reddingo.eu/dog-harness-pastel-blue-dh-zz-pb/"
                     class="card-img-top"
                     alt="Нагръдник"
                     style="height: 135px; object-fit: cover;">
                <div class="card-body p-2">
                    <h6 class="card-title fw-bold mb-1">Ергономичен нагръдник</h6>
                    <p class="card-text fw-bold text-primary small mb-1">
                        Цена: 45.00 euro
                    </p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://petsandyou.bg/images/thumbnails/400/400/detailed/88/ComfortPlus_L_Tape_5m_anthracite-550x550w.jpg.webp.webp"
                     class="card-img-top"
                     alt="Автоматичен повод"
                     style="height: 135px; object-fit: cover;">
                <div class="card-body p-2">
                    <h6 class="card-title fw-bold mb-1">Автоматичен повод (5м)</h6>
                    <p class="card-text fw-bold text-primary small mb-1">
                        Цена: 30.00 euro
                    </p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1541599540903-216a46ca1dc0?auto=format&fit=crop&w=600&q=80"
                     class="card-img-top"
                     alt="Легло за куче"
                     style="height: 135px; object-fit: cover;">
                <div class="card-body p-2">
                    <h6 class="card-title fw-bold mb-1">Ортопедично легло</h6>
                    <p class="card-text fw-bold text-primary small mb-1">
                        Цена: 25.00 euro
                    </p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&w=600&q=80"
                     class="card-img-top"
                     alt="Купички за куче"
                     style="height: 135px; object-fit: cover;">
                <div class="card-body p-2">
                    <h6 class="card-title fw-bold mb-1">Купички за храна и вода</h6>
                    <p class="card-text fw-bold text-primary small mb-1">
                        Цена: 15.00 euro
                    </p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1535294435445-d7249524ef2e?auto=format&fit=crop&w=600&q=80"
                     class="card-img-top"
                     alt="Играчка за куче"
                     style="height: 135px; object-fit: cover;">
                <div class="card-body p-2">
                    <h6 class="card-title fw-bold mb-1">Играчка за кучета</h6>
                    <p class="card-text fw-bold text-primary small mb-1">
                        Цена: 12.00 euro
                    </p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=600&q=80"
                     class="card-img-top"
                     alt="Нашийник за кучета"
                     style="height: 135px; object-fit: cover;">
                <div class="card-body p-2">
                    <h6 class="card-title fw-bold mb-1">Нашийник за кучета</h6>
                    <p class="card-text fw-bold text-primary small mb-1">
                        Цена: 18.00 euro
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>
